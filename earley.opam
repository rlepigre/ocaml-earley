homepage: "https://github.com/rlepigre/ocaml-earley"
bug-reports: "https://github.com/rlepigre/ocaml-earley/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "4.14.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/rlepigre/ocaml-earley.git"
x-maintenance-intent: ["(latest)"]
